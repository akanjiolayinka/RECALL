# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust build output (src-tauri/.gitignore also covers this)
target/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files. Recall needs none; if you make one for your own
# tooling it stays on your machine.
.env
.env.*

# Local AI model files (downloaded by a setup script, never committed)
models/

# Local Recall data: indexes, databases, caches
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.cache/

# Python virtual environments for dev scripts (e.g. scripts/generate_test_data.py)
.venv*/
__pycache__/
